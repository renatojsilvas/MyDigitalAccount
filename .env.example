# Copie para .env (ignorado pelo Git). Valores só para desenvolvimento local.
# Cada serviço valida suas variáveis no boot e falha rápido se faltar alguma.

ENVIRONMENT=development

# UID/GID do contêiner `tools` = dono do código no host, para os arquivos gerados
# não ficarem como root. No Mac: HOST_UID=$(id -u) e HOST_GID=$(id -g) (ex.: 502 e 20).
HOST_UID=1000
HOST_GID=1000
LOG_LEVEL=info

# Postgres: superusuário, só para administração (o contêiner e o script de init o usam).
POSTGRES_USER=conta
POSTGRES_PASSWORD=conta-dev-only
# Papéis de cada serviço, criados pelo job postgres-bootstrap a cada `up` (deploy/postgres/
# bootstrap.sh, ADR-0004): <svc>_owner roda as migrations (DDL); <svc>_app é o do serviço (só DML).
# Trocar uma senha aqui passa a valer no próximo `up`, sem recriar o volume.
LEDGER_DB_OWNER_PASSWORD=ledger-owner-dev-only
LEDGER_DB_APP_PASSWORD=ledger-app-dev-only
SPI_DB_OWNER_PASSWORD=spi-owner-dev-only
SPI_DB_APP_PASSWORD=spi-app-dev-only
TRANSFERS_DB_OWNER_PASSWORD=transfers-owner-dev-only
TRANSFERS_DB_APP_PASSWORD=transfers-app-dev-only
# Espera máxima por uma conta travada por outro lançamento; estourada, o ledger responde
# UNAVAILABLE e o cliente repete com a mesma chave. Mínimo 1ms (zero desligaria o limite).
LEDGER_DB_LOCK_TIMEOUT=1s
# Tamanho máximo do pool de conexões do ledger (1 a 200). É o denominador da utilização
# do pool no dashboard (método USE).
LEDGER_DB_MAX_CONNS=10
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# BFF (internas; a porta publicada no host é BFF_HOST_PORT)
BFF_HOST=0.0.0.0
LEDGER_GRPC_URL=http://ledger:50051
# Prazo de cada chamada ao ledger; vai ao ledger como deadline (header grpc-timeout)
LEDGER_TIMEOUT_MS=1000
# Prazos da home (ADR-0005): menores que o SLO de 300 ms; o extrato é cortado antes de propósito.
LEDGER_BALANCE_TIMEOUT_MS=250
LEDGER_STATEMENT_TIMEOUT_MS=200
TRANSFERS_TIMEOUT_MS=1000
TRANSFERS_LIMITS_TIMEOUT_MS=200
# Segredo do JWT (HS256, mínimo 32 caracteres). Valor só para desenvolvimento local; em
# qualquer outro ambiente, gere um aleatório (ex.: openssl rand -base64 48).
BFF_JWT_SECRET=bff-jwt-dev-only-troque-fora-do-desenvolvimento
BFF_JWT_TTL_SECONDS=900
SHUTDOWN_TIMEOUT_MS=10000

# Antifraude (ADR-0008). Prazo de cada avaliação no Redis: estourado, a decisão sai degradada.
ANTIFRAUDE_REDIS_TIMEOUT=50ms
# Falhas injetadas no boot (em execução: AntifraudeAdminService.SetFaults, por grpcurl).
ANTIFRAUDE_FAULT_LATENCY=0s
ANTIFRAUDE_FAULT_ERROR_RATE=0
# Sem os contadores do Redis, aprova só até este valor (centavos).
ANTIFRAUDE_DEGRADED_MAX_AMOUNT_CENTS=50000

# spi-fake (seção 4.5): settle | reject | settle_no_response | no_settle_no_response.
# Em execução: SpiAdminService.SetBehavior, por grpcurl.
SPI_SETTLE_MODE=settle
SPI_FAIL_STATUS_QUERIES=false
SPI_LATENCY=0s

# transfers (ADR-0007). Limite diário de Pix por conta, em centavos.
TRANSFERS_DAILY_LIMIT_CENTS=200000
# Segredo do HMAC do pedido na tabela de idempotência (mínimo 32 caracteres). Valor só para
# desenvolvimento local; em qualquer outro ambiente, gere um aleatório (openssl rand -base64 48).
TRANSFERS_REQUEST_HASH_KEY=transfers-hmac-dev-only-troque-fora-do-desenvolvimento

# Telemetria: todos os serviços exportam por OTLP para o Collector.
# Deixe comentada até subir o profile obs (passo 8); sem endpoint, nada é exportado e os
# logs seguem no stdout. Com o endpoint definido e sem Collector no ar, o export falha com ruído.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Portas internas (rede do compose): fixas, usadas pelos serviços entre si.
# POSTGRES_PORT acima continua 5432.
BFF_PORT=8088

# Portas publicadas no host (só 127.0.0.1). Mude aqui se alguma já estiver ocupada.
# No compose: "127.0.0.1:${VARIAVEL:-padrão}:porta-interna". Só afetam o acesso pelo
# navegador ou terminal da máquina; os serviços continuam se falando pelas portas internas.
POSTGRES_HOST_PORT=5432
BFF_HOST_PORT=8088
WEB_HOST_PORT=5173
LEDGER_GRPC_HOST_PORT=50051
LEDGER_ADMIN_HOST_PORT=8081
REDIS_HOST_PORT=6379
ANTIFRAUDE_GRPC_HOST_PORT=50061
SPI_GRPC_HOST_PORT=50071
TRANSFERS_GRPC_HOST_PORT=50081
GRAFANA_HOST_PORT=3000
PROMETHEUS_HOST_PORT=9090
