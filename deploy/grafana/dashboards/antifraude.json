{
  "uid": "conta-antifraude",
  "title": "Conta Digital: antifraude",
  "description": "Serviço antifraude (Fase 3, ADR-0008): RED do Evaluate, decisões e degradação, falhas injetadas, Redis (latência, memória, chaves descartadas), logs e traces. Provisionado como código: edite o JSON, não a interface.",
  "tags": [
    "conta-digital",
    "antifraude",
    "fase-3"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Evaluate (RED)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Avaliações por segundo",
      "description": "Chamadas ao Evaluate, por código de resposta.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rpc_response_status_code) (rate(rpc_server_call_duration_seconds_count{job=\"antifraude\",rpc_method=\"conta.antifraude.v1.AntifraudeService/Evaluate\"}[$__rate_interval]))",
          "legendFormat": "{{rpc_response_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Falhas do servidor (% das chamadas)",
      "description": "UNAVAILABLE aqui é, em geral, falha injetada (ver a seção Falhas injetadas).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(rpc_server_call_duration_seconds_count{job=\"antifraude\",rpc_method=\"conta.antifraude.v1.AntifraudeService/Evaluate\",rpc_response_status_code=~\"UNKNOWN|DEADLINE_EXCEEDED|INTERNAL|UNAVAILABLE|DATA_LOSS\"}[$__rate_interval])) or vector(0)) / sum(rate(rpc_server_call_duration_seconds_count{job=\"antifraude\",rpc_method=\"conta.antifraude.v1.AntifraudeService/Evaluate\"}[$__rate_interval]))",
          "legendFormat": "falhas"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latência p50 e p99",
      "description": "Inclui a latência injetada; sem injeção, deve ficar bem abaixo do prazo de 300 ms do transfers (ADR-0007).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(rpc_server_call_duration_seconds_bucket{job=\"antifraude\",rpc_method=\"conta.antifraude.v1.AntifraudeService/Evaluate\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(rpc_server_call_duration_seconds_bucket{job=\"antifraude\",rpc_method=\"conta.antifraude.v1.AntifraudeService/Evaluate\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Negócio",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Decisões por minuto",
      "description": "Aprovações e recusas, separadas por degradação (sem os contadores do Redis).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (antifraude_decision, antifraude_degraded) (rate(antifraude_decisions_total{job=\"antifraude\"}[$__rate_interval]))",
          "legendFormat": "{{antifraude_decision}} (degradado={{antifraude_degraded}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Avaliações degradadas por motivo",
      "description": "Sem resposta do Redis no prazo (timeout) ou com erro. Qualquer valor acima de zero é Redis fora do ar ou lento (ADR-0008, seção 3).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (antifraude_degraded_reason) (rate(antifraude_degraded_total{job=\"antifraude\"}[$__rate_interval]))",
          "legendFormat": "{{antifraude_degraded_reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Distribuição do score (% das avaliações não degradadas)",
      "description": "Fração das avaliações por faixa de score. A recusa começa em 60.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (le) (rate(antifraude_score_bucket{job=\"antifraude\",antifraude_degraded=\"false\"}[$__rate_interval])) / ignoring(le) group_left sum(rate(antifraude_score_count{job=\"antifraude\",antifraude_degraded=\"false\"}[$__rate_interval]))",
          "legendFormat": "score <= {{le}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Falhas injetadas",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Latência injetada",
      "description": "Valor em vigor do AntifraudeAdminService (ou ANTIFRAUDE_FAULT_LATENCY). Explica picos de latência no transfers.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(antifraude_fault_latency_seconds{job=\"antifraude\"})",
          "legendFormat": "latência"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Taxa de erro injetada",
      "description": "Fração de Evaluate que falham com UNAVAILABLE por injeção (0 a 1).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(antifraude_fault_error_rate_ratio{job=\"antifraude\"})",
          "legendFormat": "taxa"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Redis",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Latência p99 dos comandos",
      "description": "Do ponto de vista do antifraude (redisotel), por desfecho. context_timeout = estourou o prazo de ANTIFRAUDE_REDIS_TIMEOUT.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, status, error_type) (rate(db_client_connections_use_time_milliseconds_bucket{job=\"antifraude\",type=\"command\"}[$__rate_interval])))",
          "legendFormat": "{{status}} {{error_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Memória usada",
      "description": "Comparada ao maxmemory de 64 MB: perto do teto, o volatile-lru começa a descartar chaves.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(redis_memory_used_bytes)",
          "legendFormat": "usada"
        },
        {
          "refId": "B",
          "expr": "max(redis_maxmemory_bytes)",
          "legendFormat": "maxmemory"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Chaves descartadas por falta de memória",
      "description": "Risco registrado no ADR-0008: um contador descartado faz o antifraude subestimar a velocidade de uma conta. Deve ficar em zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(redis_keys_evicted_total[$__rate_interval]))",
          "legendFormat": "descartadas/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Clientes conectados",
      "description": "Conexões abertas no Redis (todos os clientes).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(redis_clients_connected)",
          "legendFormat": "clientes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "row",
      "title": "Logs e traces",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "panels": []
    },
    {
      "id": 18,
      "type": "logs",
      "title": "Logs do antifraude",
      "description": "Um log por chamada gRPC; o campo trace_id vira link para o trace no Tempo.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"antifraude\"}",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 19,
      "type": "table",
      "title": "Avaliações degradadas recentes",
      "description": "Spans do Evaluate com antifraude.degraded = true; o span tem o motivo e o evento antifraude.degraded.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"antifraude\" && span.antifraude.degraded = true }",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    }
  ]
}
